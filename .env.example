# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# On Render, add the secrets in the dashboard instead (not with "Add from .env").

# --- Server ---------------------------------------------------------------
# Leave empty for local dev. Production (Docker) sets NODE_ENV=production itself.
NODE_ENV=
# Default 3000. Render and other hosts set PORT for you.
PORT=
HOST=
# Public https address of the app, e.g. https://ventra-hackathon.onrender.com
# Needed in production so the Telegram webhook can be registered.
PUBLIC_URL=
# SQLite file. Default ./data/ventra.db (inside apps/api).
DATABASE_PATH=
# Long random string. Used to make the pseudonymous IDs sent to the AI.
SESSION_SECRET=

# --- Ask AI (Tencent Cloud ADP) -------------------------------------------
# App key of the "Ventra Care Guide" ADP app. Without it, Ask AI gives only the fixed safety replies.
ADP_KEY_GENERAL=
# Optional. Default https://wss.lke.tencentcloud.com/v1/qbot/chat/sse
ADP_CHAT_URL=

# --- Family messages (Telegram) -------------------------------------------
# From @BotFather. Without it, family alerts and summaries are off.
TELEGRAM_BOT_TOKEN=
# Long random string (letters, numbers, _ and -). Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Optional. Keeps the demo family linked after a restart on hosts that wipe the disk.
DEMO_FAMILY_CHAT_ID=
# Optional. Daily family summary time in Singapore, "minute hour * * *". Default 0 22 * * * (10 PM).
FAMILY_SUMMARY_CRON=
